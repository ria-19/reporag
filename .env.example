# Copy to .env and fill in values

# Paths (defaults work for local dev)
LANCE_DB_PATH=data/lance
KUZU_DB_PATH="data/kuzu.db"
WAL_PATH=data/wal.jsonl

# Embedding
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DEVICE=cpu        # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32

# Chunking
CHUNK_SIZE=3000
BATCH_SIZE=32

# LLM — choose one provider
LLM_PROVIDER=ollama         # ollama | gemini
LLM_MODEL=llama3.2          # for ollama

# Gemini (only needed if LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Retrieval
RETRIEVAL_K=5
RETRIEVAL_K_FETCH_MULTIPLIER=10
GRAPH_EXPAND_LIMIT=20

# Validation
LLM_JUDGE_SAMPLE_RATE=0.1   # 0.0 to disable, 1.0 for all queries

# API
ALLOWED_ORIGINS=*           # restrict in production

# Logging
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

